{ "type": "Feature", "properties": { "番號": "六", "類型": null, "分區": "不要", "郡\n支廳": "〃", "庄 (區)": "大武", "大字": "大武", "地名": "大武", "土地\n類型": "山林\n原野", "面積\n(公頃)": 450, "區分理由": null, "地        況": "位於大武支廳所在地南側，為平坦地或緩坡地。基岩為第三紀南部第三系所構成。土壤質地為黏質壤土，其中摻雜石礫，濕度乾，結合度軟，雖並非無地力貧瘠之處，相較之下大多仍屬尚可。海拔高度在325公尺以下。\n東側以山麓或道路為界。北側及西側以保安林及既有登錄地界為界；另有部分區域以稜線與準要存置林野126及127相鄰。南側以稜線與要存置林野20鄰接。", "林        況": "除了少許的闊葉林外，草生地佔此區域大部分的面積。", "參  考  事  項": "本地域設有臺東廳所屬中繼牧場預定地，面積約156公頃。於昭和4、5兩年度已獲預算撥付，其預算額如下所示。\n　　　　設備費　　其他　　　計\n昭和4年度 1,475円　 588円　 2,063円\n昭和5年度 　　0　　 588円　 　588円\n　計　　　1,475円　1,176円　2,651円" }, "geometry": { "type": "MultiPolygon", "coordinates": [ [ [ [ 120.899291668794689, 22.359825326556528 ], [ 120.899314497531321, 22.359585475916905 ], [ 120.899371585453991, 22.359265673739518 ], [ 120.899622875488276, 22.359653989016682 ], [ 120.90005686564561, 22.359345589508024 ], [ 120.89947436169831, 22.359002976315747 ], [ 120.899120279012166, 22.358591823337981 ], [ 120.899063147773404, 22.358157812788651 ], [ 120.89920019895537, 22.3580892775461 ], [ 120.898835184259198, 22.357677918269985 ], [ 120.898831281265245, 22.357673645170571 ], [ 120.898423394171814, 22.357227079756655 ], [ 120.898986810623427, 22.356663595771952 ], [ 120.899496977734898, 22.356968141212725 ], [ 120.899732993920665, 22.356564573172697 ], [ 120.899504571783865, 22.356617884416469 ], [ 120.8992360127491, 22.356343756349354 ], [ 120.899672044223976, 22.355932591794634 ], [ 120.899776056276707, 22.356046048647663 ], [ 120.900193617501131, 22.355974444354985 ], [ 120.901251983213456, 22.355898249050178 ], [ 120.901861114887922, 22.355860147424188 ], [ 120.902782445163297, 22.356126601077694 ], [ 120.903513051278651, 22.356042531766832 ], [ 120.903490664793154, 22.355986573992809 ], [ 120.903395471222908, 22.355701043602643 ], [ 120.902805320849623, 22.354796878382651 ], [ 120.901815360225058, 22.352741074705065 ], [ 120.9012537362198, 22.351370534029336 ], [ 120.900615950261084, 22.349647837151746 ], [ 120.900444608949996, 2